DATABASE_URL=postgresql://nave_demo:nave_demo_local@localhost:5433/nave_demo
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
PORT=3001

# Recuperação de senha (opcional). Sem SMTP nem Mailtrap configurados, o
# pedido é aceito normalmente, mas nenhum e-mail sai. Não use credenciais
# reais em arquivos versionados.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="NAVE <nao-responda@exemplo.test>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# Mailtrap API HTTPS. Com MAILTRAP_INBOX_ID usa o Sandbox; sem ele, usa o
# Transactional Stream de produção (o remetente precisa pertencer a um domínio verificado).
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAILTRAP_FROM_EMAIL=nao-responda@exemplo.test
MAILTRAP_API_TIMEOUT_MS=10000
