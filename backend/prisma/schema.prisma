model prontuarios_psicologia_crianca {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  prontuario_id    String      @unique @db.Uuid
  data_atendimento DateTime?   @db.Date
  profissional     String?     @db.VarChar
  nome             String?     @db.VarChar
  idade            String?     @db.VarChar
  sexo             String?     @db.VarChar
  responsavel      String?     @db.VarChar
  queixa_principal String?
  observacoes      String?
